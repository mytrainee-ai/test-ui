[Unit]
Description=Math Page Vision Lab Streamlit application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mathpage
Group=mathpage
WorkingDirectory=/opt/math-page-ci/current
EnvironmentFile=/etc/math-page-vision.env
Environment=HOME=/var/lib/math-page-app
StateDirectory=math-page-app
ExecStart=/opt/math-page-ci/current/.venv/bin/python -m streamlit run app.py --server.address 127.0.0.1 --server.port 8501 --server.headless true --server.fileWatcherType none --server.maxUploadSize 15 --browser.gatherUsageStats false
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/math-page-app

[Install]
WantedBy=multi-user.target
